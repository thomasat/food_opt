<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of FoodOptimizer.Core; the Windows-only ones skip elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests pass no cancellation token to the code under test. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <RootNamespace>FoodOptimizer.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FoodOptimizer.Core/FoodOptimizer.Core.csproj" />
  </ItemGroup>
</Project>
